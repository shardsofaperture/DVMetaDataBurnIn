{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DVMeta: check development tools",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "${workspaceFolder}/Resources/scripts/dev/check_environment.zsh"
      ],
      "problemMatcher": []
    },
    {
      "label": "DVMeta: run automated tests",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "${workspaceFolder}/Resources/scripts/dev/test_all.zsh"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "DVMeta: build macOS app",
      "type": "process",
      "command": "/bin/zsh",
      "args": [
        "${workspaceFolder}/Resources/scripts/dev/xcodebuild.zsh",
        "-project",
        "${workspaceFolder}/DVMetaDataBurnIn.xcodeproj",
        "-scheme",
        "DVMetaDataBurnIn",
        "-configuration",
        "Debug",
        "-derivedDataPath",
        "${workspaceFolder}/.build/Xcode15DerivedData",
        "CODE_SIGNING_ALLOWED=NO",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "DVMeta: open project in Xcode",
      "type": "process",
      "command": "/usr/bin/open",
      "args": [
        "-a",
        "/Volumes/1 TB Storage/xcode-15.4/Xcode.app",
        "${workspaceFolder}/DVMetaDataBurnIn.xcodeproj"
      ],
      "problemMatcher": []
    }
  ]
}
